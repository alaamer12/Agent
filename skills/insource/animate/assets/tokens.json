{
  "version": "0.1.0",
  "note": "Canonical defaults. A project's own tokens always win; extend them instead of adding a parallel set.",
  "easing": {
    "enter": "cubic-bezier(0.22, 1, 0.36, 1)",
    "move": "cubic-bezier(0.25, 1, 0.5, 1)",
    "onScreen": "cubic-bezier(0.645, 0.045, 0.355, 1)",
    "drawer": "cubic-bezier(0.32, 0.72, 0, 1)",
    "expo": "cubic-bezier(0.19, 1, 0.22, 1)",
    "press": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
    "morphOpen": "linear(0, 0.45, 0.78, 1, 1.17, 1.21, 1.18, 1.12, 1.05, 1.02, 1)",
    "morphClose": "cubic-bezier(0.32, 0.72, 0, 1)",
    "constant": "linear"
  },
  "duration_ms": {
    "press": [100, 160],
    "tooltip": [125, 200],
    "dropdown": [150, 250],
    "modal": [200, 350],
    "hoverColor": 200,
    "hoverTransform": [100, 150],
    "slide": [200, 300],
    "page": [250, 400],
    "rareMoment": [300, 600],
    "showcase": [600, 1600]
  },
  "tierCap_ms": { "routine": 300, "rare": 600, "showcase": 1600 },
  "stagger_ms": { "list": [30, 50], "section": [80, 100], "word": 80, "listTotalMax": 300 },
  "offset_px": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24 },
  "scale": {
    "pressDown": 0.97,
    "hover": [1.01, 1.02],
    "entrySubtle": 0.97,
    "entryDefault": 0.95,
    "entryPopover": 0.92,
    "entryRareMin": 0.8,
    "neverFrom": 0
  },
  "blur_px": { "bridge": [2, 4], "rareEntrance": 8, "hardCap": 20 },
  "spring": {
    "snappy": { "stiffness": 500, "damping": 40 },
    "gentle": { "stiffness": 200, "damping": 30 },
    "stiff": { "stiffness": 700, "damping": 50 },
    "bouncy": { "stiffness": 300, "damping": 20 },
    "perceptual": { "duration": 0.4, "bounce": 0 },
    "perceptualMomentum": { "duration": 0.4, "bounce": 0.2 }
  },
  "gesture": { "flickVelocity_px_per_ms": 0.11, "axisCommit_px": 10, "minTarget_px": 44 }
}
