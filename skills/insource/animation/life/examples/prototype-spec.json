      "demo_html": "<style>#stage{display:grid;place-items:center;min-height:220px;background:#f6f4f1}.btn{position:relative;overflow:hidden;padding:14px 28px;border:0;border-radius:12px;background:#1f1d1b;color:#fff;font:600 16px system-ui;cursor:pointer;transition:transform 140ms cubic-bezier(0.25,0.46,0.45,0.94)}.btn:active{transform:scale(.97)}.btn::after{content:'';position:absolute;inset:0;transform:translateX(-120%);background:linear-gradient(100deg,transparent 30%,rgba(255,255,255,.35) 50%,transparent 70%)}.btn.go::after{transition:transform 520ms cubic-bezier(0.22,1,0.36,1);transform:translateX(120%)}.btn:focus-visible{outline:2px solid #f59e0b;outline-offset:3px}@media (prefers-reduced-motion:reduce){.btn.go::after{transition:none;transform:none;opacity:0}}</style><div id='stage'><button class='btn' id='b'>Pay now</button></div><script>var b=document.getElementById('b');window.play=function(){b.classList.remove('go');void b.offsetWidth;b.classList.add('go')};b.addEventListener('pointerdown',window.play);b.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' ')window.play()});</script>"
